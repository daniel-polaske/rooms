{
  "name": "rooms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail --format pretty",
    "types": "wrangler types",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "acceptance": "node scripts/acceptance.mjs",
    "acceptance:remote": "node scripts/acceptance.mjs",
    "mutate": "stryker run",
    "mutate:changed": "stryker run --incremental",
    "gates": "npm run types && npm run check && npm run lint && npm run depcruise && npm run test:coverage",
    "drill:kill": "node scripts/drill-kill.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cucumber/cucumber": "^13.3.0",
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@vitest/coverage-istanbul": "^4.1.12",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12",
    "wrangler": "^4.0.0"
  }
}
