{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Static client. Served before the Worker for matching paths.
  "assets": { "directory": "./public", "binding": "ASSETS" },

  // Workers Logs + invocation logs. head_sampling_rate 1 = keep everything
  // (Free plan: 200k events/day, 3-day retention).
  "observability": { "enabled": true, "head_sampling_rate": 1 },

  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDO" },
      { "name": "DIRECTORY", "class_name": "DirectoryDO" }
    ]
  },
  // SQLite-backed classes: the only backend on the Free plan, and the right one anyway.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO", "DirectoryDO"] }],

  "queues": {
    "producers": [{ "binding": "ROOM_EVENTS", "queue": "room-events" }],
    "consumers": [
      {
        "queue": "room-events",
        "max_batch_size": 50,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "room-events-dlq"
      }
    ]
  },

  "workflows": [
    { "name": "rooms-archive", "binding": "ARCHIVE", "class_name": "ArchiveWorkflow" }
  ],

  // Stage 3: archives land here as JSON. Free plan: 10 GB, 1M writes/month.
  "r2_buckets": [{ "binding": "ARCHIVES", "bucket_name": "rooms-archives" }],

  // CHAOS_TOKEN: shared secret for /chaos and /archive. `wrangler secret put CHAOS_TOKEN`
  // for production; CHAOS_TOKEN=dev in .dev.vars (gitignored) for local.
  "vars": {
    // How long a room sits idle before its alarm archives it. 24 h in production;
    // override locally (.dev.vars) to something like 15000 to drill the alarm path.
    "IDLE_MS": "86400000",
    // How long the Workflow waits before marking the room archived.
    "ARCHIVE_GRACE": "1 hour",
    // Cloudflare Access: team domain and the application's AUD tag. Neither is
    // secret. Leave ACCESS_AUD empty (as .dev.vars does) to disable the JWT
    // check for local dev.
    "ACCESS_TEAM": "hypnagogia",
    "ACCESS_AUD": "22e9ccbfcb30b2b44766b353d2309e61da143da6aa75c7542ae0f60433394689"
  }
}
